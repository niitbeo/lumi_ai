+    // Distance from canonical lid apex to texture top
+    const apexCanon = CANONICAL_POINTS[isLeft ? 40 : 94];
+    const distTop = Math.abs(apexCanon[1] - texY) + 10; 
+    const distBot = Math.abs((texY + texH) - apexCanon[1]) + 10;
+
+    const tc0 = [rc0[0] + nxC * distTop, rc0[1] + nyC * distTop];
+    const bc0 = [rc0[0] - nxC * distBot, rc0[1] - nyC * distBot];
+    
+    // Do the same in real space
+    const dxR = rr1[0] - rr0[0];
+    const dyR = rr1[1] - rr0[1];
+    const lenR = Math.hypot(dxR, dyR) || 1;
+    let nxR = -dyR / lenR;
+    let nyR = dxR / lenR;
+    if (nyR > 0) { nxR = -nxR; nyR = -nyR; }
+    
+    const tr0 = [rr0[0] + nxR * distTop, rr0[1] + nyR * distTop];
+    const br0 = [rr0[0] - nxR * distBot, rr0[1] - nyR * distBot];
+    
+    const tc1 = [rc1[0] + nxC * distTop, rc1[1] + nyC * distTop];
+    const bc1 = [rc1[0] - nxC * distBot, rc1[1] - nyC * distBot];
+    
+    const tr1 = [rr1[0] + nxR * distTop, rr1[1] + nyR * distTop];
+    const br1 = [rr1[0] - nxR * distBot, rr1[1] - nyR * distBot];
