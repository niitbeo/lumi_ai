+/**
+ * Eyelid Strip Warp: Approximates GPUImageUpperEyelidRadianSmoothFilter.
+ * Bends texture along the 5 upper eyelid landmarks via normal extrapolation.
+ */
+export function drawEyelidStripWarp(
+  context: CanvasRenderingContext2D,
+  image: CanvasImageSource,
+  landmarks: number[][],
+  isLeft: boolean,
+  rect: [number, number, number, number]
+) {
+  // Upper eyelid points (inner to outer)
+  const lidIndices = isLeft ? [35, 41, 40, 42, 39] : [89, 95, 94, 96, 93];
+  const lidPts = lidIndices.map(i => landmarks[i]);
+  const lidCanonPts = lidIndices.map(i => CANONICAL_POINTS[i]);
+  
+  // Interpolate 5 points into 25 smooth points (6 segments per interval)
+  const SEGMENTS_PER_INTERVAL = 6;
+  const realSpline = interpolateSpline(lidPts, SEGMENTS_PER_INTERVAL);
+  const canonSpline = interpolateSpline(lidCanonPts, SEGMENTS_PER_INTERVAL);
+  
+  const [texX, texY, texW, texH] = rect;
+  
+  for (let i = 0; i < realSpline.length - 1; i++) {
+    const rc0 = canonSpline[i];
+    const rc1 = canonSpline[i + 1];
+    const rr0 = realSpline[i];
+    const rr1 = realSpline[i + 1];
+    
+    // Compute normals in canonical space
+    const dxC = rc1[0] - rc0[0];
+    const dyC = rc1[1] - rc0[1];
+    const lenC = Math.hypot(dxC, dyC) || 1;
+    let nxC = -dyC / lenC, nyC = dxC / lenC;
+    if (nyC > 0) { nxC = -nxC; nyC = -nyC; } // Ensure normal points UP
+    
+    // Distance from canonical lid apex to texture bounds
+    const apexCanon = CANONICAL_POINTS[isLeft ? 40 : 94];
+    const distTop = Math.abs(apexCanon[1] - texY) + 10; 
+    const distBot = Math.abs((texY + texH) - apexCanon[1]) + 10;
+
+    const tc0 = [rc0[0] + nxC * distTop, rc0[1] + nyC * distTop];
+    const bc0 = [rc0[0] - nxC * distBot, rc0[1] - nyC * distBot];
+    const tc1 = [rc1[0] + nxC * distTop, rc1[1] + nyC * distTop];
+    const bc1 = [rc1[0] - nxC * distBot, rc1[1] - nyC * distBot];
+    
+    // Compute normals in real space
+    const dxR = rr1[0] - rr0[0];
+    const dyR = rr1[1] - rr0[1];
+    const lenR = Math.hypot(dxR, dyR) || 1;
+    let nxR = -dyR / lenR, nyR = dxR / lenR;
+    if (nyR > 0) { nxR = -nxR; nyR = -nyR; } // UP
+    
+    const tr0 = [rr0[0] + nxR * distTop, rr0[1] + nyR * distTop];
+    const br0 = [rr0[0] - nxR * distBot, rr0[1] - nyR * distBot];
+    const tr1 = [rr1[0] + nxR * distTop, rr1[1] + nyR * distTop];
+    const br1 = [rr1[0] - nxR * distBot, rr1[1] - nyR * distBot];
+    
+    // Draw top/bottom triangles using solveAffine
+    const drawTri = (u0: number[], u1: number[], u2: number[], x0: number[], x1: number[], x2: number[]) => {
+      const mat = solveAffine(u0, u1, u2, x0, x1, x2);
+      if (!mat) return;
+      context.save(); context.beginPath();
+      context.moveTo(x0[0], x0[1]); context.lineTo(x1[0], x1[1]); context.lineTo(x2[0], x2[1]);
+      context.closePath(); context.clip();
+      context.setTransform(mat.a, mat.d, mat.b, mat.e, mat.c, mat.f);
+      context.drawImage(image, 0, 0); context.restore();
+    };
+    drawTri(bc0, tc0, tc1, br0, tr0, tr1); // Top triangle
+    drawTri(bc0, tc1, bc1, br0, tr1, br1); // Bottom triangle
+  }
+}
