{
    "inflator":"common",
    "version":"1.1.1.0",
    "module":"LuaTexSampler",
    "ui":{
        "ui_name":"纹理",
        "ui_name_en":"Sampler",
        "ui_name_tw":"Sampler"
    },
    "category":"Basical",
    "singleInstance":false,
    "inputs":[
        {
            "param":"bp_setFilePath",
            "dataType":"path",
            "ui":{
                "uiType": "path",
                "pathType": "file",
                "ui_name":"图片文件",
                "ui_name_en":"file",
                "ui_name_tw":"file"
            }
        },
        {
            "param":"bp_setMinFilter",
            "dataType":"string",
            "value":"LINEAR",
            "ui":{
                "uiType":"comboBox",
                "items":[
                    "LINEAR",
                    "NEAREST"
                ],
                "ui_name":"缩放过滤",
                "ui_name_en":"minFilter",
                "ui_name_tw":"minFilter"
            }
        },
        {
            "param":"bp_setMaxFilter",
            "dataType":"string",
            "value":"LINEAR",
            "ui":{
                "uiType":"comboBox",
                "items":[
                    "LINEAR",
                    "NEAREST"
                ],
                "ui_name":"放大过滤",
                "ui_name_en":"maxFilter",
                "ui_name_tw":"maxFilter"
            }
        },
        {
            "param":"bp_setWrapS",
            "dataType":"string",
            "value":"CLAMP",
            "ui":{
                "uiType":"comboBox",
                "items":[
                    "CLAMP",
                    "REPEAT"
                ],
                "ui_name":"水平寻址",
                "ui_name_en":"wrapS",
                "ui_name_tw":"wrapS"
            }
        },
        {
            "param":"bp_setWrapT",
            "dataType":"string",
            "value":"CLAMP",
            "ui":{
                "uiType":"comboBox",
                "items":[
                    "CLAMP",
                    "REPEAT"
                ],
                "ui_name":"垂直寻址",
                "ui_name_en":"wrapT",
                "ui_name_tw":"wrapT"
            }
        }
    ],
    "outputs":[
        {
            "param":"bp_getLuaTexSampler",
            "dataType":"LuaSampler",
            "ui":{
                "ui_name":"纹理",
                "ui_name_en":"Sampler",
                "ui_name_tw":"Sampler"
            }
        }
    ]
}