uniform sampler2D inputImageTexture; uniform sampler2D skinMaskTexture; uniform sampler2D fullMaskTexture; uniform vec4 skinMaskChannels; uniform vec4 fullMaskChannels; varying vec4 blurCoordinates[5]; vec4 calcBoxColor(vec4 sumColor, vec4 coordinate, float boxWeight) { float skinMask = dot(texture2D(skinMaskTexture, coordinate.zw), skinMaskChannels) * boxWeight; skinMask *= dot(texture2D(fullMaskTexture, coordinate.zw), fullMaskChannels); sumColor.rgb += texture2D(inputImageTexture, coordinate.xy).rgb * skinMask; sumColor.a += skinMask; return sumColor; } void main() { mediump float centerMask = dot(texture2D(skinMaskTexture, blurCoordinates[2].zw), skinMaskChannels); centerMask *= dot(texture2D(fullMaskTexture, blurCoordinates[2].zw), fullMaskChannels); highp float skinMask = centerMask * 4.0; mediump vec4 iColor = texture2D(inputImageTexture, blurCoordinates[2].xy); mediump vec4 sum = vec4(iColor.rgb * skinMask, skinMask); sum = calcBoxColor(sum, blurCoordinates[0], 2.0); sum = calcBoxColor(sum, blurCoordinates[1], 3.0); sum = calcBoxColor(sum, blurCoordinates[3], 3.0); sum = calcBoxColor(sum, blurCoordinates[4], 2.0); sum = sum.a > 0.0001 ? clamp(sum / sum.a, 0.0, 1.0) : iColor; gl_FragColor = vec4(mix(iColor.rgb, sum.rgb, centerMask), iColor.a); }