varying highp vec2 textureCoordinate; uniform sampler2D inputImageTexture; uniform sampler2D inputImageProcTexture; uniform lowp float alpha; void main() { lowp vec4 textureColor = texture2D(inputImageTexture, textureCoordinate); lowp vec3 newColor = texture2D(inputImageProcTexture, textureCoordinate).rgb; gl_FragColor = vec4(mix(textureColor.rgb, newColor, alpha), textureColor.a); }