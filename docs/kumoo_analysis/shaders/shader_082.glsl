uniform sampler2D inputImageTexture; uniform sampler2D skinMaskTexture; uniform sampler2D faceParsingTexture; varying highp vec4 blurCoordinates[5]; uniform highp float jointFactor; uniform lowp float averageColor; vec4 processingFun(vec4 sum, float centerGray, highp vec4 coords) { mediump vec3 tmpColor = texture2D(inputImageTexture, coords.xy).rgb; lowp float skinColor = step(0.9, texture2D(skinMaskTexture, coords.zw).g); lowp float parColor = step(0.9, texture2D(faceParsingTexture, coords.zw).a); lowp float tmpMask = min(skinColor, parColor); mediump float tmpDis = tmpColor.g - centerGray; tmpDis = 1.0 - min(tmpDis * tmpDis * jointFactor, 1.0); float isNegative = step(tmpColor.g*tmpMask, centerGray); tmpDis = mix(1.0, tmpDis, isNegative); tmpDis *= tmpMask; sum.xyz += tmpDis * tmpColor; sum.w += tmpDis; return sum; } void main() { mediump float centerMask = texture2D(skinMaskTexture, blurCoordinates[2].zw).g; mediump vec3 iColor = texture2D(inputImageTexture, blurCoordinates[2].xy).rgb; lowp float iGray = averageColor; mediump vec4 sum = vec4(0.0); sum = processingFun(sum, iGray, blurCoordinates[2]); sum = processingFun(sum, iGray, blurCoordinates[0]); sum = processingFun(sum, iGray, blurCoordinates[1]); sum = processingFun(sum, iGray, blurCoordinates[3]); sum = processingFun(sum, iGray, blurCoordinates[4]); mediump vec3 gaussColor = sum.w > 0.0001 ? clamp(sum.xyz / sum.w, 0.0, 1.0) : iColor.rgb; gl_FragColor = vec4(mix(iColor, gaussColor, centerMask), 1.0); }