uniform sampler2D inputImageTexture; uniform sampler2D offsetMap; uniform float imageWidth; uniform float imageHeight; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateCrop; void main() { highp vec2 offset = texture2D(offsetMap, textureCoordinateCrop).rg; highp float validAlpha = texture2D(offsetMap, textureCoordinateOri).b / 255.0; offset.x = offset.x / imageWidth; offset.y = offset.y / imageHeight; vec2 offsetCoord = textureCoordinateOri + validAlpha * offset; vec4 color = texture2D(inputImageTexture, offsetCoord).rgba; gl_FragColor = vec4(color); }