uniform sampler2D inputImageTexture; uniform sampler2D resTexture; uniform sampler2D lowPassTexture; uniform sampler2D wholeFaceMaskTexture; uniform sampler2D maskTexture; uniform sampler2D nevusMaskTexture; uniform float contourSmoothAlpha; uniform float sharpenAlpha; varying highp vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateParsing; varying vec4 textureShift_1; varying vec4 textureShift_2; varying vec4 textureShift_3; varying vec4 textureShift_4; void main() { mediump vec3 resColor = texture2D(resTexture, textureCoordinateCrop).rgb; mediump vec3 lowColor = texture2D(lowPassTexture, textureCoordinateCrop).rgb; mediump vec4 oriColor = texture2D(inputImageTexture, textureCoordinateOri); float edge_mask = step(0.01, textureCoordinateCrop.x)*step(0.01, textureCoordinateCrop.y)*step(textureCoordinateCrop.x, 0.99)*step(textureCoordinateCrop.y, 0.99); lowp float wholeface = texture2D(wholeFaceMaskTexture, textureCoordinateParsing).r; mediump float other_mask = 1.0-texture2D(maskTexture, textureCoordinateOri).r; other_mask *= wholeface; other_mask *= edge_mask; mediump float sum = 0.25 * oriColor.g; sum += 0.125 * texture2D(inputImageTexture, textureShift_1.xy).g; sum += 0.125 * texture2D(inputImageTexture, textureShift_1.zw).g; sum += 0.125 * texture2D(inputImageTexture, textureShift_2.xy).g; sum += 0.125 * texture2D(inputImageTexture, textureShift_2.zw).g; sum += 0.0625 * texture2D(inputImageTexture, textureShift_3.xy).g; sum += 0.0625 * texture2D(inputImageTexture, textureShift_3.zw).g; sum += 0.0625 * texture2D(inputImageTexture, textureShift_4.xy).g; sum += 0.0625 * texture2D(inputImageTexture, textureShift_4.zw).g; lowp float nevus = 1.0 - 0.5 * texture2D(nevusMaskTexture, textureCoordinateOri).r; highp vec3 color = mix(oriColor.rgb, resColor + oriColor.rgb - lowColor, nevus*contourSmoothAlpha*other_mask); highp float highColor = clamp(2.0 * (oriColor.g - sum), 0.0, 1.0); color = mix(color, clamp(color + highColor, 0.0, 1.0), 0.2*sharpenAlpha*other_mask); gl_FragColor = vec4(color, oriColor.a); }