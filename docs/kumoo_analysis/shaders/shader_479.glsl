uniform sampler2D inputImageTexture; uniform sampler2D skinMaskTexture; uniform sampler2D fullMaskTexture; uniform float toleranceFactor; varying highp vec4 blurCoordinates[7]; vec4 calcBilateGaussColor(vec4 sumColor, vec4 centerColor, vec4 coordinate, float gaussWeight) { lowp vec3 neighborColor=texture2D(inputImageTexture, coordinate.xy).rgb; float colorDist = min(distance(centerColor.rgb, neighborColor)*toleranceFactor,1.0); float mask = dot(texture2D(skinMaskTexture, coordinate.zw), skinMaskChannels); mask *= dot(texture2D(fullMaskTexture, coordinate.zw), fullMaskChannels); float sampleWeight = gaussWeight * (1.0-colorDist) * mask; sumColor.rgb += neighborColor * sampleWeight; sumColor.a += sampleWeight; return sumColor; } void main() { highp vec4 centerPoint = mix(blurCoordinates[3], blurCoordinates[4], 0.5); mediump vec4 iColor = texture2D(inputImageTexture, centerPoint.xy); highp float centerMask = dot(texture2D(skinMaskTexture, centerPoint.zw), skinMaskChannels); centerMask *= dot(texture2D(fullMaskTexture, centerPoint.zw), fullMaskChannels); float sum_weight= 0.2270270270*centerMask; mediump vec4 sum = vec4(iColor.rgb * sum_weight, sum_weight); sum = calcBilateGaussColor(sum, iColor, blurCoordinates[0], 0.0540540); sum = calcBilateGaussColor(sum, iColor, blurCoordinates[1], 0.1216216); sum = calcBilateGaussColor(sum, iColor, blurCoordinates[2], 0.1945945); sum = calcBilateGaussColor(sum, iColor, blurCoordinates[4], 0.1945945); sum = calcBilateGaussColor(sum, iColor, blurCoordinates[5], 0.1216216); sum = calcBilateGaussColor(sum, iColor, blurCoordinates[6], 0.0540540); sum = sum.a > 0.0001 ? clamp(sum / sum.a, 0.0, 1.0) : iColor; gl_FragColor = vec4(mix(iColor.rgb, sum.rgb, step(0.005, centerMask)), iColor.a); }