uniform sampler2D inputImageTexture; uniform sampler2D resTexture; uniform sampler2D skinMaskTexture; uniform sampler2D effectMaskTexture; uniform float teethCleanAlpha; varying highp vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateParsing; void main() { mediump vec4 oriColor = texture2D(inputImageTexture, textureCoordinateOri); mediump vec3 resColor = texture2D(resTexture, textureCoordinateCrop).rgb; mediump float skinMask = texture2D(skinMaskTexture, textureCoordinateParsing).r; mediump float effectMask = texture2D(effectMaskTexture, textureCoordinateCrop).r; float edge_mask = step(0.03, textureCoordinateCrop.x)*step(0.03, textureCoordinateCrop.y)*step(textureCoordinateCrop.x, 0.97)*step(textureCoordinateCrop.y, 0.97); highp vec3 color = mix(oriColor.rgb, resColor, teethCleanAlpha*edge_mask*(1.0 - skinMask) * effectMask); gl_FragColor = vec4(color, oriColor.a); }