varying vec2 textureCoordinate; varying vec2 textureCoordinate2; varying vec2 textureCoordinate3; uniform sampler2D inputImageTexture1; uniform sampler2D inputImageTexture2; uniform sampler2D inputImageTexture3; uniform sampler2D fullMaskTexture; uniform float rednessRemoveAlpha; uniform vec3 scleraAvgColor; void main() { vec4 origColor = texture2D(inputImageTexture1, textureCoordinate); vec4 lowColor = texture2D(inputImageTexture2, textureCoordinate2); vec4 maxColor = texture2D(inputImageTexture3, textureCoordinate3); lowp float fullMaskColor = texture2D(fullMaskTexture, textureCoordinate).r; highp vec4 highColor = origColor - lowColor; vec4 newColor = lowColor; float levelRed = maxColor.r > 0.001 ? max(maxColor.b, maxColor.g) / maxColor.r : 0.0; float levelRedAvg = scleraAvgColor.r > 0.001 ? max(scleraAvgColor.g, scleraAvgColor.b) / scleraAvgColor.r : 0.0; levelRed = max(levelRed, levelRedAvg); vec4 newColor1 = lowColor; vec4 newColor2 = lowColor; newColor1.r = max(newColor.r, maxColor.r); newColor2.b = max(newColor2.b, maxColor.b); newColor2.g = max(newColor2.g, maxColor.g); newColor2.r = max(newColor2.r, newColor2.g); if (newColor.b < newColor.g) { newColor1.g = newColor1.r * levelRed; float newColor1DeltaG = newColor1.g - newColor.g; newColor1.b = newColor1.b + newColor1DeltaG; newColor2.b = min(newColor2.b, newColor.b + newColor2.g - newColor.g); } else { newColor1.b = newColor1.r * levelRed; newColor1.g = newColor1.g + newColor1.b - newColor.b; newColor2.g = min(newColor2.g, newColor.g + newColor2.b - newColor.b); } vec4 newColor3 = mix(newColor2, newColor1, ((newColor.r - scleraAvgColor.r)*0.5 + 0.5)*0.8); newColor = mix(newColor, newColor3, step(0.0, levelRed)); gl_FragColor = vec4(mix(origColor.rgb, newColor.rgb + highColor.rgb, rednessRemoveAlpha*maxColor.a*fullMaskColor), origColor.a); }