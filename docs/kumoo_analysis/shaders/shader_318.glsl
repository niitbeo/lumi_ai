uniform sampler2D inputImageTexture; uniform sampler2D resTexture; uniform sampler2D lowPassTexture; uniform sampler2D wholeFaceMaskTexture; uniform float contourSmoothAlpha; varying highp vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateParsing; void main() { mediump vec3 resColor = texture2D(resTexture, textureCoordinateCrop).rgb; mediump vec3 lowColor = texture2D(lowPassTexture, textureCoordinateCrop).rgb; mediump vec4 oriColor = texture2D(inputImageTexture, textureCoordinateOri); float wholeFace = texture2D(wholeFaceMaskTexture, textureCoordinateParsing).r; float edge_mask = step(0.01, textureCoordinateCrop.x)*step(0.01, textureCoordinateCrop.y)*step(textureCoordinateCrop.x, 0.99)*step(textureCoordinateCrop.y, 0.99); highp vec3 color = mix(oriColor.rgb, oriColor.rgb+resColor-lowColor, contourSmoothAlpha*edge_mask*wholeFace); gl_FragColor = vec4(color, oriColor.a); }