uniform sampler2D inputImageTexture; uniform sampler2D resTexture; uniform sampler2D lowPassTexture; uniform sampler2D wholeFaceMaskTexture; uniform sampler2D facePartTexture; uniform sampler2D nevusMaskTexture; uniform vec2 wrinkleCleanAlpha; uniform float sharpenAlpha; varying highp vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateParsing; highp vec3 rgb2hsv(highp vec3 c) { highp vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0); highp vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g)); highp vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r)); highp float d = q.x - min(q.w, q.y); highp float e = 1.0e-10; return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x); } highp vec3 hsv2rgb(highp vec3 c) { highp vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0); highp vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www); return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y); } void main() { mediump vec3 resColor = texture2D(resTexture, textureCoordinateCrop).rgb; mediump vec3 lowColor = texture2D(lowPassTexture, textureCoordinateCrop).rgb; mediump vec4 oriColor = texture2D(inputImageTexture, textureCoordinateOri); mediump vec3 facepart = texture2D(facePartTexture, textureCoordinateOri).rgb; float edge_mask = min(smoothstep(0.49, 0.4, abs(textureCoordinateCrop.x - 0.5)),smoothstep(0.49, 0.4, abs(textureCoordinateCrop.y - 0.5))); float neuvsMask = 1.0 - texture2D(nevusMaskTexture, textureCoordinateOri).r; lowp float wholeface = texture2D(wholeFaceMaskTexture, textureCoordinateParsing).r; mediump float mask = edge_mask*neuvsMask*wholeface; vec3 delta = resColor - lowColor; vec3 resImageColor = oriColor.rgb + delta; highp vec3 ori_hsv = rgb2hsv(oriColor.rgb); highp vec3 res_hsv = rgb2hsv(resImageColor.rgb); lowp float sat_weight = clamp(mix(1.0, 0.0, abs(ori_hsv.g - res_hsv.g)), 0.0, 1.0); res_hsv.g = (res_hsv.g - ori_hsv.g) * sat_weight + ori_hsv.g; resImageColor.rgb = hsv2rgb(res_hsv); float alph