uniform sampler2D inputImageTexture; uniform sampler2D skinMaskTexture; uniform highp float texelWidthOffset; uniform highp float texelHeightOffset; uniform highp float texelWidthOffsetFace; uniform highp float texelHeightOffsetFace; varying highp vec4 blurCoordinates[5]; uniform highp float jointFactor; vec4 processingFun(vec4 sum, float centerGray, highp vec4 coords) { mediump vec3 tmpColor = texture2D(inputImageTexture, coords.xy).rgb; lowp float tmpMask = texture2D(skinMaskTexture, coords.zw).g; mediump float tmpDis = tmpColor.g - centerGray; tmpDis = 1.0 - min(tmpDis * tmpDis * jointFactor, 1.0); tmpDis *= tmpMask; sum.xyz += tmpDis * tmpColor; sum.w += tmpDis; return sum; } void main() { mediump float centerMask = texture2D(skinMaskTexture, blurCoordinates[2].zw).g; mediump vec3 iColor = texture2D(inputImageTexture, blurCoordinates[2].xy).rgb; lowp float iGray = iColor.g; mediump vec4 sum = vec4(iColor, 1.); sum = processingFun(sum, iGray, blurCoordinates[0]); sum = processingFun(sum, iGray, blurCoordinates[1]); sum = processingFun(sum, iGray, blurCoordinates[3]); sum = processingFun(sum, iGray, blurCoordinates[4]); mediump vec3 gaussColor = clamp(sum.xyz / (sum.w + 0.00001), 0.0, 1.0); gl_FragColor = vec4(mix(iColor, gaussColor, centerMask), 1.0); }