uniform sampler2D inputImageTexture; varying highp vec2 textureCoordinate; uniform sampler2D skinMaskTexture; uniform sampler2D cheekMaskTexture; uniform lowp float cheekRedAlpha; uniform lowp float noseRedAlpha; uniform lowp vec3 targetColorRatio; void main() { lowp vec4 iColor = texture2D(inputImageTexture, textureCoordinate).rgba; lowp float skinMask = texture2D(skinMaskTexture, textureCoordinate).a; lowp vec2 cheekMask = texture2D(cheekMaskTexture, textureCoordinate).rg; lowp vec3 targetColor = iColor.rgb * targetColorRatio; lowp float Alpha = (cheekMask.r * cheekRedAlpha + cheekMask.g * noseRedAlpha) * skinMask; gl_FragColor = vec4(mix(iColor.rgb, targetColor, Alpha), iColor.a); }