uniform sampler2D inputImageTexture; uniform sampler2D skinMaskTexture; uniform sampler2D fullMaskTexture; uniform vec4 skinMaskChannels; uniform vec4 fullMaskChannels; varying highp vec4 blurCoordinates[8]; uniform highp float jointFactor; vec4 processingFun(vec4 sum, float centerGray, highp vec4 coords) { mediump vec3 tmpColor = texture2D(inputImageTexture, coords.xy).rgb; lowp float tmpMask = dot(texture2D(skinMaskTexture, coords.zw), skinMaskChannels); tmpMask *= dot(texture2D(fullMaskTexture, coords.zw), fullMaskChannels); mediump float tmpDis = tmpColor.g - centerGray; tmpDis = 1.0 - min(tmpDis * tmpDis * jointFactor, 1.0); tmpDis *= tmpMask; sum.xyz += tmpDis * tmpColor; sum.w += tmpDis; return sum; } void main() { highp vec4 centerCoordinate= (blurCoordinates[3] + blurCoordinates[4]) * 0.5; mediump float centerMask = dot(texture2D(skinMaskTexture, centerCoordinate.zw), skinMaskChannels); centerMask *= dot(texture2D(fullMaskTexture, centerCoordinate.zw), fullMaskChannels); mediump vec3 iColor = texture2D(inputImageTexture, centerCoordinate.xy).rgb; lowp float iGray = iColor.g; mediump vec4 sum = vec4(iColor, 1.); sum = processingFun(sum, iGray, blurCoordinates[0]); sum = processingFun(sum, iGray, blurCoordinates[1]); sum = processingFun(sum, iGray, blurCoordinates[2]); sum = processingFun(sum, iGray, blurCoordinates[3]); sum = processingFun(sum, iGray, blurCoordinates[4]); sum = processingFun(sum, iGray, blurCoordinates[5]); sum = processingFun(sum, iGray, blurCoordinates[6]); sum = processingFun(sum, iGray, blurCoordinates[7]); mediump vec3 gaussColor = clamp(sum.xyz / (sum.w + 0.00001), 0.0, 1.0); gl_FragColor = vec4(mix(iColor, gaussColor, centerMask), 1.0); }