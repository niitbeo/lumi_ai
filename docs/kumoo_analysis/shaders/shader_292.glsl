uniform sampler2D inputImageTexture; uniform sampler2D lowpassTexture; uniform sampler2D blendMask; uniform sampler2D resTexture; uniform sampler2D wholeFaceMaskTexture; uniform sampler2D protectedMaskTexture; varying highp vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateParsing; uniform float fUseAlpha; void main() { mediump vec4 resColor = texture2D(resTexture, textureCoordinateCrop); mediump vec4 lowColor = texture2D(lowpassTexture, textureCoordinateCrop); mediump float alpha = texture2D(blendMask, textureCoordinateCrop).r; mediump vec4 oriColor = texture2D(inputImageTexture, textureCoordinateOri); mediump float wholeface = texture2D(wholeFaceMaskTexture, textureCoordinateParsing).r ; mediump float pface = 1.0 - texture2D(protectedMaskTexture, textureCoordinateOri).r ; alpha = clamp(alpha * wholeface * pface, 0.0, 1.0); gl_FragColor = vec4(mix(oriColor.rgb, clamp(resColor.rgb + oriColor.rgb - lowColor.rgb, 0.0, 1.0), alpha), alpha * fUseAlpha + (1.0 - fUseAlpha) * oriColor.a); }