uniform sampler2D inputImageTexture; uniform sampler2D skinMaskTexture; uniform sampler2D fullMaskTexture; uniform vec4 skinMaskChannels; uniform vec4 fullMaskChannels; varying highp vec4 blurCoordinates[8]; vec4 calcGaussColor(vec4 sumColor, vec4 coords, float gaussWeight) { highp float skinMask = dot(texture2D(skinMaskTexture, coords.zw), skinMaskChannels); skinMask *= dot(texture2D(fullMaskTexture, coords.zw), fullMaskChannels)* gaussWeight; sumColor.rgb += texture2D(inputImageTexture, coords.xy).rgb * skinMask; sumColor.a += skinMask; return sumColor; } void main() { highp vec4 centerPoint = (blurCoordinates[3] + blurCoordinates[4])*0.5; mediump float centerMask = dot(texture2D(skinMaskTexture, centerPoint.zw), skinMaskChannels); centerMask *= dot(texture2D(fullMaskTexture, centerPoint.zw), fullMaskChannels); highp float skinMask = centerMask*0.2270270270; mediump vec4 iColor = texture2D(inputImageTexture, centerPoint.xy); highp vec4 sum = vec4(iColor.rgb * skinMask, skinMask); sum = calcGaussColor(sum, blurCoordinates[0], 0.0162162162); sum = calcGaussColor(sum, blurCoordinates[1], 0.0540540541); sum = calcGaussColor(sum, blurCoordinates[2], 0.1216216216); sum = calcGaussColor(sum, blurCoordinates[3], 0.1945945946); sum = calcGaussColor(sum, blurCoordinates[4], 0.1945945946); sum = calcGaussColor(sum, blurCoordinates[5], 0.1216216216); sum = calcGaussColor(sum, blurCoordinates[6], 0.0540540541); sum = calcGaussColor(sum, blurCoordinates[7], 0.0162162162); sum.rgb = sum.a > 0.0001 ? clamp(sum.rgb / sum.a, 0.0, 1.0) : iColor.rgb; gl_FragColor = vec4(mix(iColor.rgb, sum.rgb, centerMask), iColor.a); }