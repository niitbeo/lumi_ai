uniform sampler2D inputImageTexture; uniform sampler2D resTexture; uniform sampler2D lowPassTexture;uniform sampler2D wholeFaceMaskTexture; uniform sampler2D offsetMaskTexture; varying highp vec2 textureCoordinateCrop; varying vec2 textureCoordinateParsing; varying vec2 textureCoordinateOri; uniform float neckCleanAlpha; void main() { mediump vec3 resColor = texture2D(resTexture, textureCoordinateCrop).rgb; mediump vec3 lowColor = texture2D(lowPassTexture, textureCoordinateCrop).rgb; mediump vec4 oriColor = texture2D(inputImageTexture, textureCoordinateOri); mediump vec3 mask = texture2D(offsetMaskTexture, textureCoordinateCrop).rgb; mediump float wholeFace = 1.0-texture2D(wholeFaceMaskTexture, textureCoordinateParsing).r; float weight = mask.b; gl_FragColor = vec4(mix(oriColor.rgb, resColor + oriColor.rgb - lowColor, weight*neckCleanAlpha), oriColor.a); }