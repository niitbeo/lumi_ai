varying vec2 textureCoordinate; varying vec2 textureCoordinateFace; uniform sampler2D inputImageTexture; uniform sampler2D lowPassTexture; uniform sampler2D medianTexture; uniform sampler2D faceAndNeckMaskTexture; uniform sampler2D skinMaskTexture; uniform lowp float sharpenAlpha; uniform lowp float threshold2; uniform lowp float threshold1; uniform lowp float blurAlpha; varying vec4 textureShift_1; varying vec4 textureShift_2; varying vec4 textureShift_3; varying vec4 textureShift_4; void main() { lowp vec4 iColor = texture2D(inputImageTexture, textureCoordinate).rgba; lowp vec3 lowColor = texture2D(lowPassTexture, textureCoordinateFace).rgb; lowp vec3 medianColor = texture2D(medianTexture, textureCoordinateFace).rgb; lowp vec3 dog2 = iColor.rgb - medianColor; lowp float skinMask = texture2D(skinMaskTexture, textureCoordinate).g; lowp vec4 faceSkinMask = texture2D(faceAndNeckMaskTexture, textureCoordinate); lowp vec3 resultColor = lowColor + dog2; mediump float sum = 0.25 * iColor.g; sum += 0.125 * texture2D(inputImageTexture, textureShift_1.xy).g; sum += 0.125 * texture2D(inputImageTexture, textureShift_1.zw).g; sum += 0.125 * texture2D(inputImageTexture, textureShift_2.xy).g; sum += 0.125 * texture2D(inputImageTexture, textureShift_2.zw).g; sum += 0.0625 * texture2D(inputImageTexture, textureShift_3.xy).g; sum += 0.0625 * texture2D(inputImageTexture, textureShift_3.zw).g; sum += 0.0625 * texture2D(inputImageTexture, textureShift_4.xy).g; sum += 0.0625 * texture2D(inputImageTexture, textureShift_4.zw).g; highp vec3 color = clamp(resultColor + 2.0 * (iColor.g - sum), 0.0, 1.0); color = mix(resultColor, color, sharpenAlpha * skinMask); lowp float faceidAlpha = step(faceSkinMask.a,threshold2) * step(threshold1, faceSkinMask.a) * blurAlpha; gl_FragColor = vec4(mix(iColor.rgb, color, faceidAlpha*skinMask*faceSkinMask.g), iColor.a); }