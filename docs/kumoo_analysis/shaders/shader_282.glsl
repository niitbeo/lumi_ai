uniform sampler2D inputImageTexture; varying highp vec2 textureCoordinate; uniform highp float texelWidthOffset; uniform highp float texelHeightOffset; uniform mediump int radius; void main() { mediump vec3 iColor = texture2D(inputImageTexture, textureCoordinate).rgb; mediump vec3 minColor = iColor; highp vec2 off1 = vec2(texelWidthOffset, texelHeightOffset); for (int i = 1; i < radius; i++) { iColor = texture2D(inputImageTexture, textureCoordinate + off1).rgb; minColor.r = min(iColor.r, minColor.r); minColor.g = min(iColor.g, minColor.g); minColor.b = min(iColor.b, minColor.b); iColor = texture2D(inputImageTexture, textureCoordinate - off1).rgb; minColor.r = min(iColor.r, minColor.r); minColor.g = min(iColor.g, minColor.g); minColor.b = min(iColor.b, minColor.b); off1 += vec2(texelWidthOffset, texelHeightOffset); } gl_FragColor = vec4(minColor, 1.0); }