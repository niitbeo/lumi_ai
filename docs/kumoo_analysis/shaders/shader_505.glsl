varying highp vec2 textureCoordinate; uniform sampler2D inputImageTexture; uniform lowp float r_threshold1; uniform lowp float r_threshold2; uniform lowp float g_threshold1; uniform lowp float g_threshold2; void main() { lowp vec2 instanceMaskColor = texture2D(inputImageTexture, textureCoordinate).rg; lowp float alpha1 = step(r_threshold1, instanceMaskColor.r) * step(instanceMaskColor.r, r_threshold2); lowp float alpha2 = step(g_threshold1, instanceMaskColor.g) * step(instanceMaskColor.g, g_threshold2); gl_FragColor = vec4(vec3(alpha1 * alpha2), 1.0); }