uniform sampler2D inputImageTexture; uniform sampler2D lowPassTexture; uniform sampler2D resTexture; uniform sampler2D highPassTexture; uniform sampler2D highResTexture; uniform sampler2D lowResTexture; uniform sampler2D skinTexture; uniform sampler2D instanceMaskTexture; uniform float r_threshold1; uniform float r_threshold2; uniform float g_threshold1; uniform float g_threshold2; uniform float bodyBlurHighAlpha; uniform float bodyBlurLowAlpha; varying highp vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; void main() { mediump vec4 oriColor = texture2D(inputImageTexture, textureCoordinateOri); mediump vec3 lowPassColor = texture2D(lowPassTexture, textureCoordinateCrop).rgb; mediump vec3 resColor = texture2D(resTexture, textureCoordinateCrop).rgb; mediump vec3 highPassColor = texture2D(highPassTexture, textureCoordinateCrop).rgb; mediump vec3 highResColor = texture2D(highResTexture, textureCoordinateCrop).rgb; mediump vec3 lowResColor = texture2D(lowResTexture, textureCoordinateCrop).rgb; lowp float skinMask = texture2D(skinTexture, textureCoordinateCrop).r; mediump float other_mask = skinMask; lowp vec2 instanceMask = texture2D(instanceMaskTexture, textureCoordinateOri).rg; float alpha1 = step(r_threshold1, instanceMask.r) * step(instanceMask.r, r_threshold2); float alpha2 = step(g_threshold1, instanceMask.g) * step(instanceMask.g, g_threshold2); other_mask *= alpha1; other_mask *= alpha2; float bodyBlurHighAlpha_abs = abs(bodyBlurHighAlpha) * 0.7; mediump vec3 highFreqPart; float isBlurHightPositive = step(0.0, bodyBlurHighAlpha); mediump vec3 highFreqNegative = oriColor.rgb - bodyBlurHighAlpha_abs * ((highPassColor - highResColor)*0.5 + highResColor - lowPassColor); mediump vec3 highFreqPositive = oriColor.rgb + 2.0 * bodyBlurHighAlpha * (highPassColor - highResColor); highFreqPart = mix(highFreqNegative, highFreqPositive, isBlurHightPositive); mediump vec3 color = highFreqPart - bodyBlurLowAlpha * (lowResColor - resColor); mediump vec3 lowMinusHig