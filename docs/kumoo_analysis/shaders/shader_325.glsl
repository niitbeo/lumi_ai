uniform sampler2D inputImageTexture; uniform sampler2D resTexture; uniform sampler2D lowpassTexture; uniform sampler2D wholeFaceMaskTexture; uniform sampler2D facePartTexture; uniform sampler2D nevusMaskTexture; uniform sampler2D skinMaskTexture; uniform float periorbitalClenAlpha; varying vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateParsing; void main() { mediump vec4 resColor = texture2D(resTexture, textureCoordinateCrop); mediump vec4 iColor = texture2D(inputImageTexture, textureCoordinateOri); mediump vec3 lowColor = texture2D(lowpassTexture, textureCoordinateCrop).rgb; mediump float wholeFace = texture2D(wholeFaceMaskTexture, textureCoordinateParsing).r; mediump float neuvsMask = 1.0 - texture2D(nevusMaskTexture, textureCoordinateOri).r; mediump float nasoMask = texture2D(facePartTexture, textureCoordinateOri).b; mediump float skinMask = smoothstep(0.4, 0.5, texture2D(skinMaskTexture, textureCoordinateParsing).b); float edge_mask = step(0.01, textureCoordinateCrop.x)*step(0.01, textureCoordinateCrop.y)*step(textureCoordinateCrop.x, 0.99)*step(textureCoordinateCrop.y, 0.99); float alpha = wholeFace * periorbitalClenAlpha * edge_mask * nasoMask * neuvsMask * skinMask; gl_FragColor = vec4(mix(iColor.rgb, resColor.rgb + iColor.rgb - lowColor, alpha), iColor.a); }