varying vec2 textureCoordinateMask; varying vec2 textureCoordinate; uniform sampler2D faceSkinMaskTexture; uniform sampler2D backgroundTexture; void main() { lowp vec3 faceSkin = texture2D(faceSkinMaskTexture, textureCoordinate).rgb; lowp vec3 background = texture2D(backgroundTexture, textureCoordinate).rgb; lowp vec3 color; color.r = max(faceSkin.r, background.r); color.g = max(faceSkin.g, background.g); color.b = max(faceSkin.b, background.b); gl_FragColor = vec4(color, 1.0); }