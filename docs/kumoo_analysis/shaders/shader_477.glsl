uniform sampler2D inputImageTexture; uniform sampler2D skinMaskTexture; uniform sampler2D fullMaskTexture; varying highp vec4 blurCoordinates[7]; uniform vec4 skinMaskChannels; uniform vec4 fullMaskChannels; vec4 calcGaussColor(vec4 sumColor, vec4 coords, float gaussWeight) { lowp float skinMask = dot(texture2D(skinMaskTexture, coords.zw),skinMaskChannels); skinMask *= dot(texture2D(fullMaskTexture, coords.zw), fullMaskChannels) * gaussWeight; sumColor.rgb += texture2D(inputImageTexture, coords.xy).rgb * skinMask; sumColor.a += skinMask; return sumColor; } void main() { mediump float centerMask = dot(texture2D(skinMaskTexture, blurCoordinates[3].zw), skinMaskChannels); centerMask *= dot(texture2D(fullMaskTexture, blurCoordinates[3].zw), fullMaskChannels); highp float skinMask = centerMask * 0.2270270270; mediump vec4 iColor = texture2D(inputImageTexture, blurCoordinates[3].xy); mediump vec4 sum = iColor * skinMask; sum.a = skinMask; sum = calcGaussColor(sum, blurCoordinates[0], 0.0540540); sum = calcGaussColor(sum, blurCoordinates[1], 0.1216216); sum = calcGaussColor(sum, blurCoordinates[2], 0.1945945); sum = calcGaussColor(sum, blurCoordinates[4], 0.1945945); sum = calcGaussColor(sum, blurCoordinates[5], 0.1216216); sum = calcGaussColor(sum, blurCoordinates[6], 0.0540540); sum = sum.a > 0.0001 ? clamp(sum / sum.a, 0.0, 1.0) : iColor; gl_FragColor = vec4(mix(iColor.rgb, sum.rgb, centerMask), iColor.a); }