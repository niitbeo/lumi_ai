varying highp vec2 textureCoordinate; uniform sampler2D inputImageTexture; uniform sampler2D inputImageTexture2; uniform sampler2D inputImageTexture3; const vec3 rgb2grayVec = vec3(0.2990, 0.5870, 0.1140); void main() { highp vec4 iColor = texture2D(inputImageTexture, textureCoordinate); highp vec4 lowColor = texture2D(inputImageTexture2, textureCoordinate); highp vec4 gaussColor = texture2D(inputImageTexture3, textureCoordinate); float detail01 = iColor.g - lowColor.g; float detail12 = lowColor.g - gaussColor.g; detail01 = (detail01 + 1.0) * 0.5; detail12 = (detail12 + 1.0) * 0.5; float iLum = dot(rgb2grayVec, iColor.rgb); float gaussLum = dot(rgb2grayVec, lowColor.rgb); float b1 = max(0.0, 0.5 * (iLum - gaussLum * gaussLum) / (gaussLum - gaussLum * gaussLum)); float b2 = min(1.0, 0.5 * (iLum + sqrt(gaussLum) - 2.0 * gaussLum) / (sqrt(gaussLum) - gaussLum)); float blend = 0.5; if (gaussLum < 0.0001) { blend = 0.5; } else if (b1 < 0.5) { blend = b1; } else if (b2 > 0.5) { blend = b2; } gl_FragColor = vec4(detail01, detail12, blend, 1.0); }