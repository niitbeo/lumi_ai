uniform sampler2D inputImageTexture; uniform sampler2D resTexture; uniform sampler2D oriTexture; uniform sampler2D facePartTexture; uniform sampler2D wholeFaceMaskTexture; uniform vec3 wrinkleCleanAlpha; varying vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateParsing; void main() { mediump vec3 resColor = texture2D(resTexture, textureCoordinateCrop).rgb; mediump vec4 curColor = texture2D(inputImageTexture, textureCoordinateOri); mediump vec3 oriColor = texture2D(oriTexture, textureCoordinateCrop).rgb; mediump float wholeFace = texture2D(wholeFaceMaskTexture, textureCoordinateParsing).r; mediump vec4 facepart = texture2D(facePartTexture, textureCoordinateOri); float alpha = max(max(wrinkleCleanAlpha.r*facepart.r, wrinkleCleanAlpha.g*facepart.g), wrinkleCleanAlpha.b*facepart.b); float edge_mask = step(0.01, textureCoordinateCrop.x)*step(0.01, textureCoordinateCrop.y)*step(textureCoordinateCrop.x, 0.99)*step(textureCoordinateCrop.y, 0.99); gl_FragColor = vec4(mix(curColor.rgb, curColor.rgb + resColor - oriColor, wholeFace * alpha * edge_mask), curColor.a); }