uniform sampler2D inputImageTexture; uniform sampler2D maskTexture; varying highp vec2 textureCoordinate; uniform highp float texelWidthOffset; uniform highp float texelHeightOffset; uniform mediump int radius; uniform mediump float threshold; void main() { mediump vec3 iColor = texture2D(inputImageTexture, textureCoordinate).rgb; lowp float mask = texture2D(maskTexture, textureCoordinate).g; lowp float maskOri = mask; mediump vec3 maxColor = vec3(0.0, 0.0, 0.0); if (mask > threshold) { maxColor = iColor; } highp vec2 off1 = vec2(texelWidthOffset, texelHeightOffset); for (int i = 1; i < radius; i++) { iColor = texture2D(inputImageTexture, textureCoordinate + off1).rgb; mask = texture2D(maskTexture, textureCoordinate + off1).g; if (mask > threshold) { maxColor.r = max(iColor.r, maxColor.r); maxColor.g = max(iColor.g, maxColor.g); maxColor.b = max(iColor.b, maxColor.b); } iColor = texture2D(inputImageTexture, textureCoordinate - off1).rgb; mask = texture2D(maskTexture, textureCoordinate - off1).g; if (mask > threshold) { maxColor.r = max(iColor.r, maxColor.r); maxColor.g = max(iColor.g, maxColor.g); maxColor.b = max(iColor.b, maxColor.b); } off1 += vec2(texelWidthOffset, texelHeightOffset); } gl_FragColor = vec4(mix(iColor, maxColor, maskOri), 1.0); }