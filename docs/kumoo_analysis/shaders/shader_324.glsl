uniform sampler2D inputImageTexture; uniform sampler2D resTexture; uniform sampler2D faceparsingMaskTexture; uniform float pandaEyeCleanAlpha; varying highp vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateParsing; void main() { highp vec4 oriColor = texture2D(inputImageTexture, textureCoordinateOri); lowp vec4 resColor = texture2D(resTexture, textureCoordinateCrop); lowp float faceparsingMask = texture2D(faceparsingMaskTexture, textureCoordinateParsing).r; lowp float silkwormMaskColor = resColor.a; highp vec3 finalColor = clamp(oriColor.rgb + resColor.rgb - vec3(0.5), 0.0, 1.0); gl_FragColor = vec4(mix(oriColor.rgb, finalColor, pandaEyeCleanAlpha * faceparsingMask * (1.0 - silkwormMaskColor)), oriColor.a); }