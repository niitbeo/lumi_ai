varying vec2 textureCoordinate; varying vec2 textureCoordinateFace; uniform sampler2D inputImageTexture; uniform sampler2D lowPassTexture; uniform sampler2D medianTexture; uniform sampler2D faceAndNeckMaskTexture; uniform sampler2D skinMaskTexture; uniform lowp float threshold2; uniform lowp float threshold1; uniform lowp float blurAlpha; void main() { lowp vec4 iColor = texture2D(inputImageTexture, textureCoordinate).rgba; lowp vec3 lowColor = texture2D(lowPassTexture, textureCoordinateFace).rgb; lowp vec3 boxColor = texture2D(medianTexture, textureCoordinateFace).rgb; highp vec3 dog2 = (iColor.rgb - boxColor) * 0.5 + 0.5; lowp float skinMask = texture2D(skinMaskTexture, textureCoordinate).g; lowp vec4 faceSkinMask = texture2D(faceAndNeckMaskTexture, textureCoordinate); lowp vec3 color = lowColor + (dog2-0.5)*2.0; lowp float faceidAlpha = step(faceSkinMask.a,threshold2) * step(threshold1, faceSkinMask.a) * blurAlpha; gl_FragColor = vec4(mix(iColor.rgb, color, faceidAlpha*skinMask*faceSkinMask.r), iColor.a); }