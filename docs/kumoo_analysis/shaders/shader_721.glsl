uniform sampler2D inputImageTexture; uniform sampler2D resTexture; uniform sampler2D lowTexture; varying highp vec2 textureCoordinateOri; varying highp vec2 textureCoordinateCrop; uniform float scleraCleanAlpha; uniform float smoothStepThres; void main() { mediump vec4 oriColor = texture2D(inputImageTexture, textureCoordinateOri); mediump vec4 resColor = texture2D(resTexture, textureCoordinateCrop); mediump vec4 lowColor = texture2D(lowTexture, textureCoordinateCrop); float weight = max(resColor.b - lowColor.b, resColor.r - lowColor.r); weight = clamp(weight*20.0, 0.0, 1.0); vec3 color = mix(resColor.rgb + oriColor.rgb - lowColor.rgb, resColor.rgb, weight); float scleraColor = smoothstep(0.0, smoothStepThres, resColor.a); gl_FragColor = vec4(mix(oriColor.rgb, color.rgb, scleraCleanAlpha*scleraColor), oriColor.a); }