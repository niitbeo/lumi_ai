uniform sampler2D inputImageTexture; uniform sampler2D resTexture; uniform sampler2D lowPassTexture; uniform sampler2D wholeFaceMaskTexture; uniform sampler2D maskTexture; uniform float shinyCleanAlpha; varying highp vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateParsing; void main() { mediump vec3 resColor = texture2D(resTexture, textureCoordinateCrop).rgb; mediump vec3 lowColor = texture2D(lowPassTexture, textureCoordinateCrop).rgb; mediump vec4 oriColor = texture2D(inputImageTexture, textureCoordinateOri); float edge_mask = step(0.01, textureCoordinateCrop.x)*step(0.01, textureCoordinateCrop.y)*step(textureCoordinateCrop.x, 0.99)*step(textureCoordinateCrop.y, 0.99); lowp float wholeface = texture2D(wholeFaceMaskTexture, textureCoordinateParsing).r; mediump float other_mask = 1.0-texture2D(maskTexture, textureCoordinateOri).r; other_mask *= wholeface; other_mask *= edge_mask; highp vec3 color = mix(oriColor.rgb, resColor + oriColor.rgb - lowColor, shinyCleanAlpha*other_mask); gl_FragColor = vec4(color, oriColor.a); }