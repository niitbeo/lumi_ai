uniform sampler2D inputImageTexture; uniform sampler2D flawMaskTexture; uniform sampler2D resTexture; uniform sampler2D deepSmoothTexture; uniform sampler2D skinMaskTexture; uniform sampler2D nevusMaskTexture; uniform lowp float isMale; varying vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateParsing; lowp float blendSoftLight(float base, float blend) { lowp float color1 = 2.0 * base * blend + base * base * (1.0 - 2.0 * blend); lowp float color2 = sqrt(base) * (2.0 * blend - 1.0) + 2.0 * base * (1.0 - blend); return mix(color1, color2, step(0.5, blend)); } void main() { lowp vec4 iColor = texture2D(inputImageTexture, textureCoordinateOri); lowp vec3 resColor = texture2D(resTexture, textureCoordinateCrop).rgb; lowp float skinMask = texture2D(skinMaskTexture, textureCoordinateParsing).r; lowp vec3 deepSmoothMask = texture2D(deepSmoothTexture, textureCoordinateOri).rgb; lowp float fleckmask = texture2D(flawMaskTexture, textureCoordinateCrop).r; lowp vec3 color = iColor.rgb; float weight = fleckmask * skinMask * (1.0-deepSmoothMask.b) * mix(1.0, 1.0-deepSmoothMask.g, isMale) * deepSmoothMask.r; color = mix(iColor.rgb, resColor, weight); float nevusMaskColor = texture2D(nevusMaskTexture, textureCoordinateOri).r; gl_FragColor = vec4(mix(color, iColor.rgb, nevusMaskColor), iColor.a); }