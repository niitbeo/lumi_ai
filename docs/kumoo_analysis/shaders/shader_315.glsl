uniform sampler2D inputImageTexture; uniform sampler2D resTexture; uniform sampler2D lowPassTexture; uniform sampler2D nevusMaskTexture; uniform sampler2D skinMaskTexture; uniform float alpha; uniform float alpha2; varying highp vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateParsing; void main() { mediump vec3 resColor = texture2D(resTexture, textureCoordinateCrop).rgb; mediump vec3 lowColor = texture2D(lowPassTexture, textureCoordinateCrop).rgb; mediump vec4 oriColor = texture2D(inputImageTexture, textureCoordinateOri); lowp float nevus = texture2D(nevusMaskTexture, textureCoordinateCrop).r; lowp float skin = texture2D(skinMaskTexture, textureCoordinateParsing).r; lowp vec3 color = oriColor.rgb + (resColor - lowColor); float edge_mask = step(0.01, textureCoordinateCrop.x)*step(0.01, textureCoordinateCrop.y)*step(textureCoordinateCrop.x, 0.99)*step(textureCoordinateCrop.y, 0.99); color = mix(oriColor.rgb, color, edge_mask*skin*(1.0 - nevus) * alpha); color = mix(color, resColor, alpha2 * nevus); gl_FragColor = vec4(color, oriColor.a); }