uniform sampler2D inputImageTexture; uniform sampler2D resTexture; uniform sampler2D lowPassTexture; uniform sampler2D wholeFaceMaskTexture; uniform sampler2D maskTexture; uniform float neutralGrayEnhanceAlpha; varying highp vec2 textureCoordinateCrop; varying vec2 textureCoordinateOri; varying vec2 textureCoordinateParsing; lowp float blendSoftLight(float base, float blend) { lowp float color1 = 2.0 * base * blend + base * base * (1.0 - 2.0 * blend); lowp float color2 = sqrt(base) * (2.0 * blend - 1.0) + 2.0 * base * (1.0 - blend); return mix(color1, color2, step(0.5, blend)); } void main() { mediump float neutralGrayLight = texture2D(resTexture, textureCoordinateCrop).r; mediump vec3 lowColor = texture2D(lowPassTexture, textureCoordinateCrop).rgb; mediump vec4 oriColor = texture2D(inputImageTexture, textureCoordinateOri); vec3 resColor = vec3(0.0); resColor.r = blendSoftLight(lowColor.r, neutralGrayLight); resColor.g = blendSoftLight(lowColor.g, neutralGrayLight); resColor.b = blendSoftLight(lowColor.b, neutralGrayLight); float edge_mask = step(0.01, textureCoordinateCrop.x)*step(0.01, textureCoordinateCrop.y)*step(textureCoordinateCrop.x, 0.99)*step(textureCoordinateCrop.y, 0.99); lowp float wholeface = texture2D(wholeFaceMaskTexture, textureCoordinateParsing).r; mediump float other_mask = 1.0-texture2D(maskTexture, textureCoordinateOri).r; other_mask *= wholeface; other_mask *= edge_mask; highp vec3 color = mix(oriColor.rgb, resColor + oriColor.rgb - lowColor, neutralGrayEnhanceAlpha*other_mask); gl_FragColor = vec4(color, oriColor.a); }