uniform sampler2D inputImageTexture; uniform sampler2D maskTexture; varying highp vec2 textureCoordinate; uniform highp float texelWidthOffset; uniform highp float texelHeightOffset; uniform mediump int radius; uniform mediump float threshold; void main() { mediump vec3 iColor = texture2D(inputImageTexture, textureCoordinate).rgb; lowp float mask = texture2D(maskTexture, textureCoordinate).g; lowp float maskOri = mask; mediump vec3 minColor = vec3(1.0, 1.0, 1.0); if (mask > threshold) { minColor = iColor; } highp vec2 off1 = vec2(texelWidthOffset, texelHeightOffset); for (int i = 1; i < radius; i++) { iColor = texture2D(inputImageTexture, textureCoordinate + off1).rgb; mask = texture2D(maskTexture, textureCoordinate + off1).g; if (mask > threshold) { minColor.r = min(iColor.r, minColor.r); minColor.g = min(iColor.g, minColor.g); minColor.b = min(iColor.b, minColor.b); } iColor = texture2D(inputImageTexture, textureCoordinate - off1).rgb; mask = texture2D(maskTexture, textureCoordinate - off1).g; if (mask > threshold) { minColor.r = min(iColor.r, minColor.r); minColor.g = min(iColor.g, minColor.g); minColor.b = min(iColor.b, minColor.b); } off1 += vec2(texelWidthOffset, texelHeightOffset); } gl_FragColor = vec4(mix(iColor, minColor, maskOri), 1.0); }