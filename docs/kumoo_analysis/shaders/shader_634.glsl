uniform sampler2D inputImageTexture; uniform float radius; varying highp vec2 textureCoordinate; uniform highp vec2 texelOffset; void main() { mediump vec4 iColor = texture2D(inputImageTexture, textureCoordinate); mediump vec4 minColor = iColor; for (float y = -radius; y <= radius; y++) { for (float x = -radius; x <= radius; x++) { vec4 color = texture2D(inputImageTexture, textureCoordinate + vec2(x, y) * texelOffset); minColor = min(color, minColor); } } gl_FragColor = minColor; }