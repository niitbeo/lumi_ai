uniform sampler2D inputImageTexture; varying highp vec2 textureCoordinate; uniform highp float texelWidthOffset; uniform highp float texelHeightOffset; uniform mediump int radius; void main() { mediump vec3 iColor = texture2D(inputImageTexture, textureCoordinate).rgb; mediump vec3 maxColor = iColor; highp vec2 off1 = vec2(texelWidthOffset, texelHeightOffset); for (int i = 1; i < radius; i++) { iColor = texture2D(inputImageTexture, textureCoordinate + off1).rgb; maxColor.r = max(iColor.r, maxColor.r); maxColor.g = max(iColor.g, maxColor.g); maxColor.b = max(iColor.b, maxColor.b); iColor = texture2D(inputImageTexture, textureCoordinate - off1).rgb; maxColor.r = max(iColor.r, maxColor.r); maxColor.g = max(iColor.g, maxColor.g); maxColor.b = max(iColor.b, maxColor.b); off1 += vec2(texelWidthOffset, texelHeightOffset); } gl_FragColor = vec4(maxColor, 1.0); }