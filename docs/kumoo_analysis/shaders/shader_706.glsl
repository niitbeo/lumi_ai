varying vec2 textureCoordinate; uniform sampler2D inputImageTexture; uniform sampler2D resCacheTexture; uniform sampler2D flawMaskTexture; uniform sampler2D maskTexture; uniform sampler2D instanceCacheTexture; uniform sampler2D contourMaskTexture; uniform float r_threshold1; uniform float r_threshold2; uniform float g_threshold1; uniform float g_threshold2; uniform float bodyBlurAlpha; uniform float bodyBlurAlpha2; void main() { lowp vec4 iColor = texture2D(inputImageTexture, textureCoordinate); lowp vec3 resCacheColor = texture2D(resCacheTexture, textureCoordinate).rgb; lowp vec3 instanceMask = texture2D(instanceCacheTexture, textureCoordinate).rgb; lowp float skinMask = texture2D(contourMaskTexture, textureCoordinate).r; lowp float mask = texture2D(maskTexture, textureCoordinate).r; lowp float flawMask = texture2D(flawMaskTexture, textureCoordinate).r; lowp float alpha1 = step(r_threshold1, instanceMask.r) * step(instanceMask.r, r_threshold2); lowp float alpha2 = step(g_threshold1, instanceMask.g) * step(instanceMask.g, g_threshold2); gl_FragColor = vec4(mix(iColor.rgb, resCacheColor, skinMask * alpha1 * alpha2 * (1.0 - mask) * max(flawMask * bodyBlurAlpha2, bodyBlurAlpha)), iColor.a); }